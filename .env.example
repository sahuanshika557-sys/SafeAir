# GEMINI_API_KEY: Required server-side key for Gemini AI API calls.
# Configure this in AI Studio Secrets or Vercel Project Settings -> Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional: Override the default public Gemini model ("gemini-2.5-flash") and fallback ("gemini-2.5-flash-lite").
# GEMINI_MODEL="gemini-2.5-flash"
# GEMINI_FALLBACK_MODEL="gemini-2.5-flash-lite"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
